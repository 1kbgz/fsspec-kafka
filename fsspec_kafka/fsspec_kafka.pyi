def librdkafka_version() -> str: ...
def builtin_features() -> list[str]: ...
def linked_to_libfsspec() -> bool: ...
def list_topics(config: dict[str, str], timeout: float = 10.0) -> list[str]: ...

class RustKafkaFile:
    @property
    def closed(self) -> bool: ...
    def read(self, size: int = -1) -> bytes: ...
    def write(self, data: bytes) -> int: ...
    def seek(self, offset: int, whence: int = 0) -> int: ...
    def tell(self) -> int: ...
    def flush(self) -> None: ...
    def close(self) -> None: ...
    def discard(self) -> None: ...

class RustKafkaStream:
    @property
    def positions(self) -> dict[int, int]: ...
    @property
    def closed(self) -> bool: ...
    def poll(self, timeout: float) -> bytes | None: ...
    def close(self) -> None: ...

class RustKafkaFs:
    def __init__(
        self,
        config: dict[str, str],
        timeout: float = 10.0,
        window_size: int = 10000,
        list_format: str = "arrow",
        batch_size: int = 1024,
        allow_admin: bool = False,
        partitions: int = -1,
        replication: int = -1,
        topic_config: dict[str, str] = ...,
        value_format: str = ...,
        value_schema: bytes | None = ...,
        value_schema_id: int | None = ...,
        avro_schema: str | None = ...,
        avro_writers: list[tuple[int, str]] | None = ...,
        flatten_value: bool = ...,
        key_column: str | None = ...,
        partition_column: str | None = ...,
        timestamp_column: str | None = ...,
        headers_column: str | None = ...,
    ) -> None: ...
    def ls(self, path: str) -> list[dict]: ...
    def info(self, path: str) -> dict: ...
    def open(self, path: str, mode: str = "rb") -> RustKafkaFile: ...
    def cat_file(self, path: str, start: int | None = None, end: int | None = None) -> bytes: ...
    def pipe_file(self, path: str, data: bytes) -> None: ...
    def rm_file(self, path: str) -> None: ...
    def mkdir(self, path: str) -> None: ...
    def rmdir(self, path: str) -> None: ...
    def stream(self, path: str, start: str | int | dict[int, int]) -> RustKafkaStream: ...
